-- Consulta completa paciente + enfermería
SELECT 
    p.nombre,
    p.apellido,
    p.numero_documento,
    e.presion_arterial,
    e.frecuencia_cardiaca,
    e.temperatura,
    e.observacion,
    e.fecha_registro
FROM pacientes p
JOIN paciente_enfermeria e ON p.id = e.fk_paciente;
